<!doctype html>
<html lang="id" class="h-full">
 <head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Untuk Kamu ❤️</title>
  <script src="https://cdn.tailwindcss.com/3.4.17"></script>
  <script src="https://cdn.jsdelivr.net/npm/lucide@0.263.0/dist/umd/lucide.min.js"></script>
  <script src="/_sdk/element_sdk.js"></script>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&amp;family=Lora:ital@0;1&amp;display=swap" rel="stylesheet">
  <style>
    @keyframes float {
      0%, 100% { transform: translateY(0) rotate(0deg); }
      50% { transform: translateY(-20px) rotate(5deg); }
    }
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(30px); }
      to { opacity: 1; transform: translateY(0); }
    }
    @keyframes pulse-heart {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.15); }
    }
    @keyframes sparkle {
      0%, 100% { opacity: 0; transform: scale(0); }
      50% { opacity: 1; transform: scale(1); }
    }
    .float-anim { animation: float 4s ease-in-out infinite; }
    .fade-up { animation: fadeUp 1s ease forwards; opacity: 0; }
    .fade-up-d1 { animation-delay: 0.3s; }
    .fade-up-d2 { animation-delay: 0.6s; }
    .fade-up-d3 { animation-delay: 0.9s; }
    .fade-up-d4 { animation-delay: 1.2s; }
    .pulse-heart { animation: pulse-heart 1.5s ease-in-out infinite; }
    .sparkle { animation: sparkle 2s ease-in-out infinite; }
    .sparkle-d1 { animation-delay: 0.5s; }
    .sparkle-d2 { animation-delay: 1s; }
    .sparkle-d3 { animation-delay: 1.5s; }
  </style>
  <style>body { box-sizing: border-box; }</style>
  <script src="/_sdk/data_sdk.js" type="text/javascript"></script>
 <script src="/_sdk/telemetry_sdk.js"></script></head>
 <body class="h-full">
  <div id="app" class="h-full w-full overflow-auto relative" style="background: linear-gradient(135deg, #1a0a2e 0%, #2d1b4e 30%, #4a1942 60%, #1a0a2e 100%);">
   <!-- Sparkles -->
   <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div class="sparkle absolute top-[10%] left-[15%] w-2 h-2 bg-pink-300 rounded-full"></div>
    <div class="sparkle sparkle-d1 absolute top-[25%] right-[20%] w-1.5 h-1.5 bg-purple-300 rounded-full"></div>
    <div class="sparkle sparkle-d2 absolute top-[60%] left-[10%] w-1 h-1 bg-rose-300 rounded-full"></div>
    <div class="sparkle sparkle-d3 absolute top-[75%] right-[15%] w-2 h-2 bg-pink-200 rounded-full"></div>
    <div class="sparkle sparkle-d1 absolute top-[40%] left-[80%] w-1.5 h-1.5 bg-fuchsia-300 rounded-full"></div>
    <div class="sparkle sparkle-d2 absolute top-[85%] left-[50%] w-1 h-1 bg-purple-200 rounded-full"></div>
   </div>
   <div class="relative z-10 flex flex-col items-center justify-center min-h-full px-6 py-12 text-center">
    <!-- Heart -->
    <div class="fade-up mb-6">
     <div class="pulse-heart text-6xl">
      💖
     </div>
    </div><!-- Name -->
    <h1 id="partner-name" class="fade-up fade-up-d1 text-4xl md:text-5xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-pink-300 via-rose-300 to-fuchsia-300 mb-4" style="font-family: 'Playfair Display', serif;">Untuk Kamu</h1><!-- Floating hearts -->
    <div class="fade-up fade-up-d1 flex gap-4 mb-8">
     <span class="float-anim text-2xl" style="animation-delay: 0s;">🌹</span> <span class="float-anim text-2xl" style="animation-delay: 0.5s;">✨</span> <span class="float-anim text-2xl" style="animation-delay: 1s;">🌹</span>
    </div><!-- Message card -->
    <div class="fade-up fade-up-d2 max-w-lg w-full rounded-3xl p-8 md:p-10 backdrop-blur-md" style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); box-shadow: 0 8px 32px rgba(219,39,119,0.15);">
     <p id="love-message" class="text-lg md:text-xl leading-relaxed text-rose-100/90 whitespace-pre-wrap" style="font-family: 'Lora', serif; font-style: italic;"></p>
    </div><!-- Closing -->
    <div class="fade-up fade-up-d3 mt-8">
     <p id="closing-text" class="text-pink-300/80 text-base" style="font-family: 'Lora', serif;">— Dengan segenap cinta, dari aku untukmu ♥</p>
    </div><!-- Bottom decoration -->
    <div class="fade-up fade-up-d4 mt-10 flex gap-2 text-xl">
     <span class="float-anim" style="animation-delay: 0.2s;">💗</span> <span class="float-anim" style="animation-delay: 0.6s;">💗</span> <span class="float-anim" style="animation-delay: 1s;">💗</span>
    </div>
   </div>
  </div>
  <script>
    lucide.createIcons();

    const defaultConfig = {
      partner_name: "Untuk Kamu",
      love_message: "Hai Sayang, kamu tau apa yang buaya sering lakukan? dia ngomong \"kalo aku chat ada yang marah ga?\" WKWKWK, bukan sebenernya buaya itu binatang paling setia, dan paling pemberani dalam menjaga hubungannya. aku harap kita selalu kaya gitu, masalah itu biasa, tapi bagaimana respon kita itu yang diuji.\n\naku ga mau jadi orang yang overthinking, aku ga mau jadi orang yang selalu termakan hal hal negatif, aku bersyukur kamu ada untuk ingetin aku, long text yang kamu kasih itu motivasi buat aku terus memperbaiki diri. aku juga belajar cinta itu bukan 100 to 100000 tapi 0 ke tak terbatas, aku bukan bilang kamu ga 100% buat aku, yang aku maksud ibarat sebuah program bisnis di jalanin dan ada 2 ide yang berbeda kita harus memfilter itu (aku pake gambaran bisnis biar kamu gampang nangkep), kita harus memilih mana yang bisa kita kembangin, sama halnya cinta, kita saling melengkapi dari apa yang kurang.\n\nkamu tau aku selalu berusaha jadi yang terbaik buat kamu, aku mau setara sama kamu, aku mau km jadi pendampingku bukan hanya sebatas pacar tapi masa depanku juga. kadang aku ga bisa ngasih apa yang kamu mau aku sedih, kaya yang aku bilang mungkin aku menang di hati kamu tapi aku merasa kalah sama sainganmu atau orang orang yang bisa kasih kamu lebih, tapi gapapa mulai sekarang aku jadiin motivasi buat aku bisa sukses demi kamu, demi aku, demi kita (anjay kata kata jason 2026) WKWKWK.\n\nsayang, aku tau aku banyak salah, aku tau aku banyak kurang, aku tau aku banyak gagal memahami kamu, tapi boleh ya aku minta tolong bantu aku, ajarin aku jadi yang bisa ngertiin kamu, yang selalu bisa jadi seseorang yang akan selalu mendampingi kamu.\n\naku harap hubungan ini sampai nikah ya, maafin aku kalo aku ngasih long textnya lewat website ini, private kok, cuman kamu yang tau...",
      closing_text: "for my lovely partner\n-Felina Fransiska Elwi",
      background_color: "#1a0a2e",
      card_color: "#ffffff0d",
      text_color: "#ffe4e6",
      primary_action: "#f9a8d4",
      font_family: "Playfair Display",
      font_size: 18
    };

    function applyConfig(config) {
      document.getElementById('partner-name').textContent = config.partner_name || defaultConfig.partner_name;
      document.getElementById('love-message').textContent = config.love_message || defaultConfig.love_message;
      document.getElementById('closing-text').textContent = config.closing_text || defaultConfig.closing_text;

      const baseSize = config.font_size || defaultConfig.font_size;
      const font = config.font_family || defaultConfig.font_family;
      
      document.getElementById('partner-name').style.fontFamily = `${font}, serif`;
      document.getElementById('partner-name').style.fontSize = `${baseSize * 2.2}px`;
      document.getElementById('love-message').style.fontSize = `${baseSize}px`;
      document.getElementById('love-message').style.fontFamily = `Lora, ${font}, serif`;
      document.getElementById('closing-text').style.fontSize = `${baseSize * 0.85}px`;

      const bg = config.background_color || defaultConfig.background_color;
      document.getElementById('app').style.background = `linear-gradient(135deg, ${bg} 0%, #2d1b4e 30%, #4a1942 60%, ${bg} 100%)`;
      
      document.getElementById('love-message').style.color = config.text_color || defaultConfig.text_color;
      document.getElementById('closing-text').style.color = config.primary_action || defaultConfig.primary_action;
    }

    window.elementSdk.init({
      defaultConfig,
      onConfigChange: async (config) => { applyConfig(config); },
      mapToCapabilities: (config) => ({
        recolorables: [
          { get: () => config.background_color || defaultConfig.background_color, set: (v) => { config.background_color = v; window.elementSdk.setConfig({ background_color: v }); } },
          { get: () => config.card_color || defaultConfig.card_color, set: (v) => { config.card_color = v; window.elementSdk.setConfig({ card_color: v }); } },
          { get: () => config.text_color || defaultConfig.text_color, set: (v) => { config.text_color = v; window.elementSdk.setConfig({ text_color: v }); } },
          { get: () => config.primary_action || defaultConfig.primary_action, set: (v) => { config.primary_action = v; window.elementSdk.setConfig({ primary_action: v }); } }
        ],
        borderables: [],
        fontEditable: { get: () => config.font_family || defaultConfig.font_family, set: (v) => { config.font_family = v; window.elementSdk.setConfig({ font_family: v }); } },
        fontSizeable: { get: () => config.font_size || defaultConfig.font_size, set: (v) => { config.font_size = v; window.elementSdk.setConfig({ font_size: v }); } }
      }),
      mapToEditPanelValues: (config) => new Map([
        ["partner_name", config.partner_name || defaultConfig.partner_name],
        ["love_message", config.love_message || defaultConfig.love_message],
        ["closing_text", config.closing_text || defaultConfig.closing_text]
      ])
    });
  </script>
